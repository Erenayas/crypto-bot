# Copy this file to `.env` and fill in your TESTNET keys:
#
#   cp .env.example .env
#   nano .env
#
# Get keys from https://testnet.binancefuture.com -- log in, then scroll to the
# bottom of the trading page where API Key and Secret Key are shown.
#
# `.env` is gitignored. Never commit it, never paste it into a chat, an issue,
# or a bug report. These are testnet keys and are worthless if leaked, which is
# exactly why testnet is where you build the habit.

BINANCE_API_KEY=
BINANCE_API_SECRET=
